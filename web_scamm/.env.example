# Copy to .env and customize for production deployments
SECRET_KEY=replace-with-a-long-random-secret-key
DATABASE_URL=sqlite:///./scamshield.db

# Hugging Face Hub repository hosting the fine-tuned XLM-RoBERTa model
HF_MODEL_REPO=bangta/Scam-detection
# Optional: set HF_TOKEN only if the Hugging Face repository is private or for CI uploads
HF_TOKEN=
